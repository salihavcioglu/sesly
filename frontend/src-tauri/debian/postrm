#!/bin/sh
# Sesly — .deb post-remove hook.
#
# Cleans up the relocated ffprobe directory tree on purge/remove. We only
# remove our own files — never the parent /usr/lib if other packages share it.

set -e

case "$1" in
  purge|remove)
    rm -f /usr/lib/sesly/bin/ffprobe || true
    rmdir /usr/lib/sesly/bin 2>/dev/null || true
    rmdir /usr/lib/sesly 2>/dev/null || true
    ;;
esac

exit 0
